{
  "expo": {
    "name": "PearOffice",
    "slug": "pearoffice",
    "version": "1.1.6",
    "newArchEnabled": true,
    "orientation": "default",
    "scheme": "pearoffice",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "android": {
      "package": "com.pearoffice",
      "versionCode": 10,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#00271b"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "pearoffice",
              "host": "join"
            },
            {
              "scheme": "pearoffice",
              "host": "seeder"
            },
            {
              "scheme": "pearoffice",
              "host": "link"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            },
            {
              "mimeType": "application/vnd.ms-excel"
            },
            {
              "mimeType": "application/vnd.oasis.opendocument.spreadsheet"
            },
            {
              "mimeType": "text/csv"
            },
            {
              "mimeType": "text/comma-separated-values"
            },
            {
              "mimeType": "text/tab-separated-values"
            },
            {
              "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            },
            {
              "mimeType": "application/vnd.oasis.opendocument.text"
            },
            {
              "mimeType": "text/markdown"
            },
            {
              "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
            },
            {
              "mimeType": "application/vnd.oasis.opendocument.presentation"
            },
            {
              "mimeType": "application/pdf"
            }
          ]
        },
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            },
            {
              "mimeType": "application/vnd.ms-excel"
            },
            {
              "mimeType": "application/vnd.oasis.opendocument.spreadsheet"
            },
            {
              "mimeType": "text/csv"
            },
            {
              "mimeType": "text/comma-separated-values"
            },
            {
              "mimeType": "text/tab-separated-values"
            },
            {
              "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            },
            {
              "mimeType": "application/vnd.oasis.opendocument.text"
            },
            {
              "mimeType": "text/markdown"
            },
            {
              "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
            },
            {
              "mimeType": "application/vnd.oasis.opendocument.presentation"
            },
            {
              "mimeType": "application/pdf"
            }
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.pearoffice",
      "buildNumber": "10",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "PearOffice connects directly to the people you share files with, and to your own devices, on your Wi-Fi.",
        "NSBonjourServices": [
          "_hyperswarm._udp",
          "_pearofficelan._tcp"
        ],
        "LSApplicationQueriesSchemes": [
          "lightning"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "PearOffice saves pictures and exported files to your photos when you choose to.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Spreadsheet",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "org.openxmlformats.spreadsheetml.sheet",
              "com.microsoft.excel.xls",
              "org.oasis-open.opendocument.spreadsheet",
              "public.comma-separated-values-text",
              "public.tab-separated-values-text"
            ]
          },
          {
            "CFBundleTypeName": "Document",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "org.openxmlformats.wordprocessingml.document",
              "org.oasis-open.opendocument.text",
              "net.daringfireball.markdown"
            ]
          },
          {
            "CFBundleTypeName": "Presentation",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "org.openxmlformats.presentationml.presentation",
              "org.oasis-open.opendocument.presentation"
            ]
          },
          {
            "CFBundleTypeName": "PDF",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.adobe.pdf"
            ]
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      "./plugins/with-android-debug-standalone",
      "./plugins/with-android-release-signing",
      "./plugins/with-android-abis",
      "./plugins/with-gradle-jvmargs",
      "./plugins/with-android-queries",
      "./plugins/with-android-backup-exclusion",
      "./plugins/with-android-webview-recovery",
      "./plugins/with-ios-pod-deployment-target",
      "./plugins/with-ios-scene-lifecycle",
      [
        "expo-image-picker",
        {
          "photosPermission": "PearOffice adds the photos you choose to your documents.",
          "cameraPermission": "PearOffice uses the camera to scan invite, device and seeder QR codes, and to take photos for your documents.",
          "microphonePermission": "PearOffice does not record sound. iOS asks because the camera, which PearOffice uses to scan QR codes, can also record it."
        }
      ]
    ],
    "assets": [
      "./assets/bare-universal.bundle",
      "./assets/bare-ios.bundle",
      "./assets/app-ui.bundle"
    ]
  }
}
