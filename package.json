{
  "name": "pearoffice",
  "version": "1.1.6",
  "private": true,
  "description": "Peer-to-peer shared spreadsheets. No accounts, no servers.",
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:worklet": "node scripts/build-worklet.js",
    "build:ui": "node scripts/build-ui.mjs",
    "desktop": "node scripts/run-desktop.js",
    "test:bare": "node scripts/bare-test.js",
    "smoke:desktop": "node scripts/smoke-desktop.js",
    "verify": "npm test && npm run test:bare && npm run smoke:desktop",
    "build:seeder": "node scripts/build-seeder.js",
    "seeder": "node scripts/run-seeder.js",
    "dist:linux": "node scripts/dist-linux.js",
    "dist:mac": "SIGN=1 scripts/build-desktop-mac.sh arm64",
    "dist:windows": "node scripts/dist-windows.js",
    "dist:windows:vm": "scripts/build-desktop-windows.sh",
    "build:bare:mobile": "bare-pack --linked --defer fs --defer path --defer bare-process --imports scripts/bare-imports.js -o assets/bare-universal.bundle src/worklet/bare.js",
    "build:ui:mobile": "node scripts/build-ui.mjs --minify --mobile",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android": "scripts/build-android.sh",
    "dist:seeder": "node scripts/dist-seeder.js",
    "build:bare:ios": "bare-pack --preset ios --defer fs --defer path --defer bare-process --imports scripts/bare-imports.js -o assets/bare-ios.bundle src/worklet/bare.js",
    "dist:mac:intel": "SIGN=1 scripts/build-desktop-mac.sh x64",
    "postinstall": "node scripts/sync-peerloom-packages.js"
  },
  "dependencies": {
    "@formulajs/formulajs": "^4.6.1",
